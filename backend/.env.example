# Groq API key used by the RAG pipeline
GROQ_API_KEY=your_groq_api_key_here

# Local development:
# Leave empty to use the backend directory.
#
# Railway production:
# DOCUAI_DATA_DIR=/data
DOCUAI_DATA_DIR=

# Local development can leave this blank.
# Set this to the deployed frontend origin in production.
# Example:
# FRONTEND_URL=https://your-docuai-app.vercel.app
FRONTEND_URL=
