# =========================================================
# DOCUAI ROOT .gitignore
# =========================================================


# -------------------------
# Environment Variables
# -------------------------

.env
.env.*
!.env.example

backend/.env
frontend/.env


# -------------------------
# Python
# -------------------------

__pycache__/
*.py[cod]
*.pyo
*.pyd

venv/
.venv/

backend/venv/
backend/.venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/


# -------------------------
# Node / React / Vite
# -------------------------

node_modules/

frontend/node_modules/

dist/
build/

frontend/dist/
frontend/build/

.vite/


# -------------------------
# DOCUAI Local Data
# -------------------------

# Uploaded PDFs
backend/uploads/*

# Keep directory if you later add .gitkeep
!backend/uploads/.gitkeep


# FAISS vector store
backend/vector_store/*

!backend/vector_store/.gitkeep


# Local document registry
backend/data/documents.json


# -------------------------
# Logs
# -------------------------

*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# -------------------------
# IDE / Editor
# -------------------------

.vscode/
.idea/

*.swp
*.swo


# -------------------------
# Operating System
# -------------------------

.DS_Store
Thumbs.db
desktop.ini


# -------------------------
# Temporary Files
# -------------------------

*.tmp
*.temp
*.bak
*.cache

temp/
tmp/


# -------------------------
# Python Packaging
# -------------------------

*.egg-info/
.eggs/

pip-wheel-metadata/


# -------------------------
# Coverage
# -------------------------

.coverage
htmlcov/
coverage.xml